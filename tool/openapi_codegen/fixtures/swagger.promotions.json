        "required": [
          "id",
          "code",
          "name",
          "type",
          "status",
          "maxUsage",
          "maxUsagePerUser",
          "currentUsage",
          "validFrom",
          "validUntil",
          "allowedUserTypes",
          "specificUserIds",
          "createdAt"
