<?xml version="1.0" encoding="utf-8"?>
<!-- SOLO DEBUG (src/debug): permite http (cleartext) hacia el backend e2e local — alias del host en
     el emulador (10.0.2.2) y localhost/127.0.0.1 (dispositivo físico con `adb reverse`). El
     manifiesto principal no define networkSecurityConfig, así que release/profile siguen con el
     default de Android (cleartext bloqueado, targetSdk >= 28). Para un dispositivo físico por IP de
     LAN, usar `adb reverse tcp:3100 tcp:3100` en lugar de abrir más dominios acá. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
